{
  "manifest_version": 3,
  "name": "Suno Library Downloader",
  "version": "1.0.0",
  "description": "Bulk download all songs from your Suno.ai library as MP3 files",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Suno Downloader"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://suno.com/*", "*://www.suno.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["*://suno.com/*", "*://www.suno.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "cookies",
    "downloads",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://suno.com/*",
    "*://www.suno.com/*",
    "*://studio-api.suno.ai/*",
    "*://cdn1.suno.ai/*",
    "*://cdn2.suno.ai/*",
    "*://clerk.suno.com/*"
  ]
}
